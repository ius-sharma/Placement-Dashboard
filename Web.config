<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="PlacementDb" providerName="System.Data.SqlClient"
      connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=PlacementPractical9;Integrated Security=True;" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
</configuration>
